#!/usr/bin/env python3
"""Real CLI/PTY checks. Synthetic credentials, no provider traffic."""
import json
import os
from pathlib import Path
import importlib.util as packet_import
packet_spec = packet_import.spec_from_file_location('native_packet', Path(__file__).resolve().parent.parent / 'scripts/native-packet.py')
native_packet = packet_import.module_from_spec(packet_spec)
packet_spec.loader.exec_module(native_packet)
import pty
import select
import signal
import subprocess
import sys
import tempfile
import termios
import time

binary = str(Path(sys.argv[1]).resolve())
with tempfile.TemporaryDirectory(prefix="blackbird-auth-cli-") as tmp:
    root = Path(tmp).resolve()
    env = dict(os.environ, BLACKBIRD_AUTH_HOME=str(root / "auth"))
    key = "synthetic-provider-secret-ONLY-IN-STDIN"
    master, slave = pty.openpty()
    before = termios.tcgetattr(slave)
    child = subprocess.Popen([binary, "auth", "key", "mimo", "work"], stdin=slave,
                             stdout=slave, stderr=slave, env=env)
    wire = bytearray()
    try:
        until = time.monotonic() + 5
        while b"API key" not in wire:
            if time.monotonic() > until:
                raise RuntimeError("missing key prompt")
            if select.select([master], [], [], .1)[0]:
                wire.extend(os.read(master, 4096))
        assert not termios.tcgetattr(slave)[3] & termios.ECHO, "key prompt preceded echo suppression"
        os.write(master, (key + "\n").encode())
        assert child.wait(timeout=5) == 0
        while select.select([master], [], [], .05)[0]:
            wire.extend(os.read(master, 4096))
        assert key.encode() not in wire, "secret echoed"
        assert termios.tcgetattr(slave) == before, "terminal mode not restored"
    finally:
        if child.poll() is None:
            child.kill()
            child.wait()
        os.close(master)
        os.close(slave)
    secret_file = root / "auth/credentials.bbm"
    assert secret_file.stat().st_mode & 0o777 == 0o600
    assert key.encode() in secret_file.read_bytes()
    for command in (["auth", "status"], ["auth", "providers"],
                    ["--session", str(root / "session"), "--once", "/auth"],
                    ["--session", str(root / "session"), "--once",
                     '/lua blackbird.call("provider_auth_status", "{}")']):
        output = subprocess.check_output([binary, *command], env=env, stderr=subprocess.STDOUT, timeout=5)
        assert key.encode() not in output
    for file in (root / "session").rglob("*"):
        if file.is_file():
            assert key.encode() not in file.read_bytes(), f"secret in session {file.name}"
    subprocess.run([binary, "auth", "logout", "mimo", "work"], env=env, check=True,
                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5)
    assert key.encode() not in secret_file.read_bytes(), "logout retained key"
    # An interrupted secret prompt restores terminal mode and writes no account.
    master, slave = pty.openpty()
    before = termios.tcgetattr(slave)
    child = subprocess.Popen([binary, "auth", "key", "grok", "cancelled"], stdin=slave,
                             stdout=slave, stderr=slave, env=env)
    wire = bytearray()
    try:
        until = time.monotonic() + 5
        while b"API key" not in wire:
            if time.monotonic() > until:
                raise RuntimeError("missing cancellation prompt")
            if select.select([master], [], [], .1)[0]:
                wire.extend(os.read(master, 4096))
        child.send_signal(signal.SIGINT)
        assert child.wait(timeout=5) == 1
        assert termios.tcgetattr(slave) == before, "cancel left echo disabled"
        assert not any(a["account"] == "cancelled" for a in native_packet.read_packet(secret_file)["accounts"])
    finally:
        if child.poll() is None:
            child.kill()
            child.wait()
        os.close(master)
        os.close(slave)
print("Provider auth CLI/PTY checks passed")
