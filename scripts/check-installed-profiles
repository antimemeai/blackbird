#!/usr/bin/env python3
"""Three-location provider profile check (P1b, docs/CONTEXT_LIFECYCLE_PLAN.md §3 P1b).

A real release install of this checkout into a scratch prefix, one --once request
against a mock OpenRouter transport, then: the request's recorded profile and the
session's provider-profile-set-v1 record must equal what the source tree's build and
a scripts/check-linux run compute for the same profile set. No provider, account or
operator-home access: every run uses a scratch home.
"""
import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
CURL = r"""#!/bin/sh
cat > /dev/null
printf '%s\n\n' 'data: {"type":"response.completed","response":{"id":"resp1","status":"completed","model":"openai/gpt-6.1-sol","output":[{"id":"m1","type":"message","role":"assistant","status":"completed","content":[{"type":"output_text","text":"INSTALLED_PROFILE_DONE"}]}],"usage":{"input_tokens":1,"output_tokens":1}}}'
printf 'data: [DONE]\n\n\n200'
"""


def digest_lines(text, prefix=""):
    """{'set-digest': value, 'set-content-digest': value, 'effective': {id: rest}}."""
    found = {"effective": {}}
    for line in text.splitlines():
        if prefix:
            if not line.startswith(prefix + " "):
                continue
            line = line[len(prefix) + 1:]
        name, _, rest = line.partition(" ")
        if name in ("set-digest", "set-content-digest"):
            if found.setdefault(name, rest) != rest:
                raise AssertionError(f"{prefix or 'output'}: two {name} values")
        elif name == "effective":
            profile = rest.split(" ", 1)[0]
            found["effective"][profile] = rest
    for name in ("set-digest", "set-content-digest"):
        if name not in found:
            raise AssertionError(f"{prefix or 'output'}: no {name} line")
    return found


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--build", default=str(ROOT / "build/debug"),
                        help="source-tree build with blackbird and profile_wiring_test")
    parser.add_argument("--linux-log", action="append", default=[],
                        help="a scripts/check-linux checks.log whose digests must agree")
    parser.add_argument("--jobs", default="6")
    parser.add_argument("--keep", action="store_true", help="keep the scratch prefix")
    args = parser.parse_args()
    build = Path(args.build).resolve()
    for tool in ("blackbird", "profile_wiring_test"):
        if not (build / tool).is_file():
            raise SystemExit(f"missing {build / tool}; build it first")
    scratch = Path(tempfile.mkdtemp(prefix="blackbird-installed-profiles-")).resolve()
    print(f"Scratch: {scratch}", flush=True)
    ok = False
    try:
        home = scratch / "home"
        home.mkdir()
        base = {key: value for key, value in os.environ.items()
                if not key.startswith(("BLACKBIRD_", "ARCO_", "OPENROUTER_"))}
        base["HOME"] = str(home)
        base["BLACKBIRD_AUTH_HOME"] = str(scratch / "auth")
        prefix = scratch / "prefix"
        subprocess.run([str(ROOT / "scripts/install-blackbird"), "--prefix", str(prefix),
                        "--source", str(ROOT), "--jobs", args.jobs], env=base, check=True)
        generation = (prefix / "lib/blackbird/current").resolve(strict=True)
        installed = prefix / "bin/blackbird"
        curl = scratch / "curl"
        curl.write_text(CURL)
        curl.chmod(0o700)
        session = scratch / "session"
        request_env = dict(base, OPENROUTER_API_KEY="fixture-secret",
                           BLACKBIRD_OPENROUTER_CURL=str(curl), BLACKBIRD_GRAPHICS="off")
        once = subprocess.run([str(installed), "--session", str(session), "--provider",
                               "openrouter", "--model", "openai/gpt-6.1-sol", "--once",
                               "hello"], env=request_env, capture_output=True, text=True,
                              timeout=120)
        assert once.returncode == 0 and "INSTALLED_PROFILE_DONE" in once.stdout, \
            (once.returncode, once.stdout, once.stderr)
        read = subprocess.run([str(build / "profile_wiring_test"), "read", str(session)],
                              capture_output=True, text=True, check=True).stdout
        requests = [line.split(" ", 1)[1] for line in read.splitlines()
                    if line.startswith("request-profile ")]
        record = re.fullmatch(r"set-record digest (\S+) content-digest (\S+) shipped (.+)",
                              next(line for line in read.splitlines()
                                   if line.startswith("set-record ")))
        assert requests, read
        assert len(set(requests)) == 1, f"the request profile changed within a run: {requests}"
        request = requests[0]
        profile = request.split(" ", 1)[0]
        shipped = generation / "share/blackbird/profiles/providers"
        assert Path(record.group(3)) == shipped, (record.group(3), shipped)
        locations = {
            "installed": digest_lines(subprocess.run(
                [str(installed), "--profile-digests"], env=base, capture_output=True,
                text=True, check=True).stdout),
            "source": digest_lines(subprocess.run(
                [str(build / "blackbird"), "--profile-digests"], env=base,
                capture_output=True, text=True, check=True).stdout),
        }
        for log in args.linux_log:
            text = Path(log).read_text(errors="replace")
            names = sorted(set(re.findall(r"^linux-(\w+) set-digest ", text, re.M)))
            if not names:
                raise AssertionError(f"{log}: no linux-* digest location (did that run build blackbird?)")
            for name in names:
                locations[f"linux-{name} ({log})"] = digest_lines(text, "linux-" + name)
        if not args.linux_log:
            print("No --linux-log given: the Linux location is not compared.", flush=True)
        session_set = {"set-digest": record.group(1), "set-content-digest": record.group(2)}
        for where, found in locations.items():
            for name, value in session_set.items():
                assert found[name] == value, f"{where}: {name} {found[name]} != session {value}"
            assert found["effective"].get(profile) == request, \
                f"{where}: effective {found['effective'].get(profile)} != request {request}"
        print(f"request-profile {request}")
        print(f"set-digest {record.group(1)}")
        print(f"set-content-digest {record.group(2)}")
        print("Agree: the installed session's request and set record; " +
              ", ".join(locations) + ".")
        ok = True
    finally:
        if args.keep or not ok:
            print(f"Scratch kept: {scratch}", file=sys.stderr)
        else:
            shutil.rmtree(scratch, ignore_errors=True)


if __name__ == "__main__":
    main()
