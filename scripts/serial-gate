#!/usr/bin/env python3
"""Run one commit through the pre-commit gate, alone on this host, and log overlaps.

Usage: scripts/serial-gate [git commit arguments...]

Refuses to start while another rigor, ctest, ninja or clang process runs. During
the gate it samples, every 5 seconds, every such process and the load average
into context/gate-logs/. A sample naming a process outside the gate's own
process group is an overlap. A load-sensitive failure during an overlap belongs
to the overlap, not the change (docs/CONTEXT_LIFECYCLE_PLAN.md section 5.1).
"""
import datetime
import glob
import os
import re
import subprocess
import sys
import threading
import time

ROOT = subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip()
PATTERN = re.compile(r"scripts/rigor|\bctest\b|\bninja\b|\bclang(\+\+|-tidy|-format)?\b")


def others(gate=None):
    """Matching processes outside this process's ancestry and the gate's own tree.

    ninja and ctest put their children in new process groups, so the gate's own
    work is recognised by parentage, not by process group.
    """
    rows = subprocess.check_output(["ps", "-axo", "pid=,ppid=,command="], text=True)
    parents, commands = {}, {}
    for row in rows.splitlines():
        pid, ppid, command = row.strip().split(None, 2)
        parents[int(pid)] = int(ppid)
        commands[int(pid)] = command
    mine, pid = set(), os.getpid()
    while pid > 1 and pid not in mine:
        mine.add(pid)
        pid = parents.get(pid, 1)

    def in_gate(pid):
        seen = set()
        while gate is not None and pid > 1 and pid not in seen:
            if pid == gate:
                return True
            seen.add(pid)
            pid = parents.get(pid, 1)
        return False

    return [f"{pid} {parents[pid]} {command[:200]}" for pid, command in commands.items()
            if pid not in mine and PATTERN.search(command) and not in_gate(pid)]


def main():
    busy = others()
    if busy:
        print("serial-gate: another build or gate is running; not starting:", file=sys.stderr)
        for line in busy:
            print("  " + line, file=sys.stderr)
        return 2
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    branch = subprocess.check_output(["git", "branch", "--show-current"], text=True).strip()
    logs = os.path.join(ROOT, "context", "gate-logs")
    os.makedirs(logs, exist_ok=True)
    path = os.path.join(logs, f"{stamp}-{branch.replace('/', '_')}.log")
    log = open(path, "w", buffering=1)
    log.write(f"gate {stamp} branch {branch} head "
              f"{subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()}\n")
    child = subprocess.Popen(["git", "commit", *sys.argv[1:]], cwd=ROOT,
                             stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    done = threading.Event()
    overlaps = 0
    peak = 0.0

    def sample():
        nonlocal overlaps, peak
        while not done.wait(5):
            load = subprocess.check_output(["sysctl", "-n", "vm.loadavg"], text=True).strip()
            peak = max(peak, float(load.strip("{} ").split()[0]))
            seen = others(gate=child.pid)
            overlaps += bool(seen)
            log.write(f"sample {time.time():.0f} load {load} others {len(seen)}\n")
            for line in seen:
                log.write(f"  other {line}\n")

    sampler = threading.Thread(target=sample, daemon=True)
    sampler.start()
    status = child.wait()
    done.set()
    sampler.join()
    for lock in sorted(glob.glob("/private/tmp/blackbird-hook.lock*")):
        log.write(f"lock {lock} mtime {os.path.getmtime(lock):.0f}\n")
    log.write(f"exit {status} overlapping_samples {overlaps} peak_load {peak}\n")
    log.close()
    print(f"serial-gate: exit {status}, overlapping samples {overlaps}, peak load {peak:.2f}, "
          f"log {os.path.relpath(path, ROOT)}")
    return status


if __name__ == "__main__":
    sys.exit(main())
