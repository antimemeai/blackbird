#!/usr/bin/env python3
"""Actual current-session center through the pinned Microsoft terminal driver."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('executable', type=Path)
    parser.add_argument('--artifacts', type=Path, required=True)
    parser.add_argument('--backend', choices=('ghostty', 'alacritty'), default='ghostty')
    args = parser.parse_args()
    executable = args.executable.resolve()
    artifacts = args.artifacts.resolve() / (args.backend + '-' + uuid.uuid4().hex[:10])
    artifacts.mkdir(parents=True)
    tool = ROOT / 'scripts/tui-test'
    subprocess.run([str(tool), '--check'], check=True, timeout=10)
    session = 'blackbird-center-' + uuid.uuid4().hex
    history = []

    def call(*command, check=True):
        record = {'command': list(command)}
        history.append(record)
        result = subprocess.run([str(tool), '--session', session, '--json',
                                 '--failure-artifacts', str(artifacts), *command],
                                capture_output=True, text=True, timeout=12)
        record.update(returncode=result.returncode, stdout=result.stdout, stderr=result.stderr)
        if check and result.returncode:
            raise AssertionError(f'{command}: {result.stdout}\n{result.stderr}')
        return json.loads(result.stdout) if result.stdout.strip() else {}

    def state():
        return call('state')['data']

    def expect(text):
        call('expect', 'text', text, '--timeout', '4000')

    def wait_state(predicate, label):
        deadline = time.monotonic() + 4
        latest = None
        while time.monotonic() < deadline:
            latest = state()
            if predicate(latest):
                return latest
            time.sleep(.03)
        raise AssertionError(f'{label}: {latest}')

    def interrupted(number, _frame):
        raise InterruptedError(f'center fixture interrupted by signal {number}')

    prior = {number: signal.signal(number, interrupted)
             for number in (signal.SIGTERM, signal.SIGINT, signal.SIGALRM)}
    failure = cleanup_error = None
    opened = False
    signal.alarm(45)
    with tempfile.TemporaryDirectory(prefix='blackbird-center-') as temporary:
        work = Path(temporary)
        effects = work / 'effects'
        identities = work / 'identities'
        requests = work / 'requests'
        release = work / 'release'
        bin_dir = work / 'bin'
        bin_dir.mkdir()
        fake = bin_dir / 'claude'
        fake.write_text('#!' + sys.executable + '\n' +
                        'import json,os,sys,time\nfrom pathlib import Path\n' +
                        'root=Path(' + repr(str(work)) + ')\n' +
                        "tag='ONE' if 'REQ_ONE' in ' '.join(sys.argv) else 'TWO'\n" +
                        "fd=os.open(root/'requests',os.O_WRONLY|os.O_CREAT|os.O_APPEND,0o600)\n" +
                        "os.write(fd,(tag+'\\n').encode());os.close(fd)\n" +
                        "while not (root/'release').exists():time.sleep(.01)\n" +
                        "print(json.dumps(dict(type='result',subtype='success',is_error=False," +
                        "result='CENTER_ANSWER_'+tag,modelUsage={'center-fixture':{}})))\n")
        fake.chmod(0o700)
        worker = work / 'job.py'
        worker.write_text('import os,sys,time\nfrom pathlib import Path\n' +
                          'root=Path(' + repr(str(work)) + ')\n' +
                          "fd=os.open(root/'effects',os.O_WRONLY|os.O_CREAT|os.O_APPEND,0o600)\n" +
                          "os.write(fd,b'JOB\\n');os.close(fd)\n" +
                          "print('CENTER_FAILED_OUTPUT',flush=True)\n" +
                          "for i in range(24):print('CENTER_ROW_%02d'%i,flush=True)\n" +
                          "while not (root/'release').exists():time.sleep(.01)\n" +
                          'sys.exit(7)\n')
        ledger = work / 'ledger.py'
        ledger.write_text('import os,sys\nfrom pathlib import Path\n' +
                          'root=Path(' + repr(str(work)) + ')\n' +
                          "fd=os.open(root/'effects',os.O_WRONLY|os.O_CREAT|os.O_APPEND,0o600)\n" +
                          "os.write(fd,b'LEDGER\\n');os.close(fd)\n" +
                          "(root/'identities').write_text('\\n'.join(sys.argv[1:])+'\\n')\n")
        workflow = work / 'turn.lua'
        workflow.write_text(
            "local q=blackbird.tasks.read(); local added=blackbird.tasks.edit({" +
            "op_id='center-seed',base=q.revision,ops={{op='add',title='CENTER_BLOCKED'," +
            "status='blocked',blocker='WAIT_FOR_REVIEW',owner='declared label'}}});" +
            "assert(added.accepted); local t=added.changed[1];\n" +
            "local function request(tag) return {request_id='center-'..tag," +
            "from='main',to=tag,provider='claude',model='fake',task=tag," +
            "context={{id='source',text='selected fixture'}}," +
            "profile={name='context-only',provenance='center-local-fake'," +
            "timeout_seconds=20,tools='none',requests=1}} end\n" +
            "local a=blackbird.participants.start({request=request('REQ_ONE'),task_id=t.id});\n" +
            "local b=blackbird.participants.start({request=request('REQ_TWO')});\n" +
            "local j=blackbird.call('exec',{yield_ms=0,argv={" +
            json.dumps(sys.executable) + ',' + json.dumps(str(worker)) + "}});\n" +
            "local k=blackbird.call('exec',{argv={" + json.dumps(sys.executable) + ',' +
            json.dumps(str(ledger)) + ",t.id,a.run_id,b.run_id,j.job_id}});\n" +
            "print('CENTER_LEDGER_JOB '..k.job_id)\n" +
            "print('CENTER_FIXTURE_READY')\n")
        config = work / 'tui-test.toml'
        config.write_text('')
        (artifacts / 'identity.json').write_text(json.dumps({
            'executable': str(executable),
            'sha256': hashlib.sha256(executable.read_bytes()).hexdigest(),
            'backend': args.backend, 'session': session}, indent=2) + '\n')
        try:
            opened = True
            call('run', '--backend', args.backend, '--config', str(config),
                 '--env', 'BLACKBIRD_GRAPHICS=off', '--env',
                 'PATH=' + str(bin_dir) + ':' + os.environ['PATH'],
                 '--cols', '101', '--rows', '30',
                 '--', str(executable), '--session', str(work / 'session'),
                 '--workflow', str(workflow), '--model', 'gpt-6.1-sol')
            expect('Workflow reloads')
            call('write', 'DRAFT_CENTER_SENTRY')
            call('key', 'press', 'Left')
            call('key', 'press', 'Left')
            before = state()
            (artifacts / 'before-open.json').write_text(json.dumps(before, indent=2) + '\n')
            call('write', '\x18')
            # Permanent actual-old-source RED: Ctrl-X was ignored, before effects.
            expect('COMMAND CENTER')
            assert not effects.exists(), 'opening center executed work'
            call('write', '\x18')
            restored = wait_state(lambda s: 'COMMAND CENTER' not in s['text'], 'close center')
            assert 'DRAFT_CENTER_SENTRY' in restored['text'], 'center lost draft'
            assert restored['cursor'] == before['cursor'], 'center moved byte cursor'

            call('write', '\x15fixture\r')
            expect('CENTER_FIXTURE_READY')
            expect('Turn complete')
            deadline = time.monotonic() + 4
            while not identities.exists() and time.monotonic() < deadline:
                time.sleep(.01)
            assert identities.exists(), 'actual owner IDs were not written'
            task_id, bound, unbound, failed_job = identities.read_text().splitlines()
            returned = state()['text']
            ledger_match = re.search(r'CENTER_LEDGER_JOB ([a-f0-9]{32})', returned)
            assert ledger_match, 'ledger command actual returned ID missing'
            ledger_job = ledger_match.group(1)
            assert task_id == 't1' and all(re.fullmatch('[a-f0-9]{32}', v)
                                         for v in (bound, unbound, failed_job))
            assert len({bound, unbound, failed_job, ledger_job}) == 4
            (artifacts / 'fixture-identities.json').write_text(json.dumps({
                'task': task_id, 'bound': bound, 'unbound': unbound,
                'failed_job': failed_job, 'ledger_job': ledger_job}, indent=2) + '\n')
            call('write', 'return_center_draft')
            call('key', 'press', 'Left')
            call('key', 'press', 'Left')
            draft_before = state()
            call('write', '\x18')
            expect('COMMAND CENTER')

            def detail(snapshot):
                # Literal settled split geometry: divider33, detail origin34.
                return '\n'.join(row[34:100] for row in snapshot['text'].splitlines()[2:25])

            def select(index, kind, identifier):
                call('key', 'press', 'Left')
                call('key', 'press', 'Home')
                for _ in range(index):
                    call('key', 'press', 'Down')
                expected_title = kind + ' ' + identifier
                return wait_state(lambda s: detail(s).splitlines()[0].lstrip(' >') ==
                                  expected_title, 'selected real source ' + expected_title)

            selected = select(0, 'Task', task_id)
            assert 'Declared blocked' in detail(selected) and 'WAIT_FOR_REVIEW' in detail(selected)
            assert 'declared label' in detail(selected), 'declared owner lost'
            release.touch()
            participants = sorted([bound, unbound])
            for identifier in participants:
                select(1 + participants.index(identifier), 'Participant', identifier)
                answer = 'CENTER_ANSWER_ONE' if identifier == bound else 'CENTER_ANSWER_TWO'
                selected = wait_state(lambda s: identifier in detail(s) and
                                      'waiting' in detail(s) and answer in detail(s),
                                      'actual participant waiting with its retained answer')
                binding = 'Task: ' + (task_id if identifier == bound else 'unbound')
                assert binding in detail(selected), 'participant task binding was inferred or lost'
            # Two setup jobs exist; the failed one is identified from real ledger,
            # never from title text or echoed Lua. Find its full selected detail.
            commands = sorted([failed_job, ledger_job])
            select(3 + commands.index(failed_job), 'Command', failed_job)
            selected = wait_state(lambda s: failed_job in detail(s) and
                                  'CENTER_FAILED_OUTPUT' in detail(s) and
                                  bool(re.search(r'[Ee]xit\s+7', detail(s))),
                                  'actual failed command source')
            assert failed_job in detail(selected)
            center_selected = failed_job
            assert 'CENTER_ROW_23' not in detail(selected), 'fixture output does not exercise reading scroll'
            call('key', 'press', 'Right')
            call('key', 'press', 'PageDown')
            center_reading = wait_state(lambda s: failed_job in detail(s) and
                                       'CENTER_ROW_23' in detail(s), 'center result reading position')
            call('write', '\x0f')
            expect('COMMAND RESULTS')
            call('key', 'press', 'Home')
            first_jobs = wait_state(lambda s: commands[0] in detail(s),
                                    'command-inspector actual first source')
            call('write', '\x18')
            selected = wait_state(lambda s: 'COMMAND CENTER' in s['text'] and
                                  center_selected in detail(s), 'center route anchor')
            assert detail(selected) == detail(center_reading), 'center reading anchor changed across jobs route'
            call('write', '\x0f')
            restored_jobs = wait_state(lambda s: 'COMMAND RESULTS' in s['text'], 'jobs route return')
            assert detail(restored_jobs) == detail(first_jobs), 'jobs route selection/reading changed'
            call('write', '\x18')
            wait_state(lambda s: center_selected in detail(s), 'second center return')
            call('resize', '32', '12')
            expect('COMMAND CENTER')
            call('key', 'press', 'Right')
            call('key', 'press', 'End')
            expect('CENTER_ROW_23')
            small = state()
            assert 0 <= small['cursor']['x'] < 32 and 0 <= small['cursor']['y'] < 12
            call('resize', '101', '30')
            wait_state(lambda s: center_selected in detail(s), 'wide selected source after reflow')
            for identifier in participants:
                selected = select(1 + participants.index(identifier), 'Participant', identifier)
                assert 'waiting' in detail(selected), 'browsing sealed/joined participant'
            selected = select(0, 'Task', task_id)
            assert 'Declared blocked' in detail(selected) and 'WAIT_FOR_REVIEW' in detail(selected), \
                'browsing completed or mutated declared task'
            select(3 + commands.index(failed_job), 'Command', failed_job)
            call('write', '\x18')
            restored = wait_state(lambda s: 'COMMAND CENTER' not in s['text'] and
                                  'COMMAND RESULTS' not in s['text'], 'return editor')
            assert 'return_center_draft' in restored['text']
            assert restored['cursor'] == draft_before['cursor'], 'route/resize lost byte cursor'
            call('write', '\x15\x1b[200~literal \x18 \x0f \x03 data\x1b[201~')
            expect('literal \\x18 \\x0f \\x03 data')
            assert 'COMMAND CENTER' not in state()['text'], 'pasted control opened center'
            assert 'COMMAND RESULTS' not in state()['text'], 'pasted control opened jobs'
            assert sorted(effects.read_text().splitlines()) == ['JOB', 'LEDGER'], 'browsing relaunched work'
            assert sorted(requests.read_text().splitlines()) == ['ONE', 'TWO'], 'browsing sent/joined work'
            call('write', '\x15/center\r')
            expect('COMMAND CENTER')
            final = state()
            (artifacts / 'final-state.json').write_text(json.dumps(final, indent=2) + '\n')
            call('screenshot', '-o', str(artifacts / 'final.svg'))
            call('write', '\x18')
            call('write', '\x11')
            call('wait', 'exit', '--timeout', '4000')
        except BaseException as error:
            failure = error
        finally:
            signal.alarm(0)
            for number in prior:
                signal.signal(number, signal.SIG_IGN)
            try:
                if opened:
                    result = call('close', check=False)
                    if result.get('ok') is not True:
                        raise AssertionError(f'owned terminal cleanup failed: {result}')
            except BaseException as error:
                cleanup_error = error
            finally:
                (artifacts / 'commands.json').write_text(json.dumps(history, indent=2) + '\n')
                for name in ('effects', 'requests', 'identities', 'turn.lua'):
                    if (work / name).is_file():
                        (artifacts / ('fixture-' + name)).write_bytes((work / name).read_bytes())
                for number, handler in prior.items():
                    signal.signal(number, handler)
            if failure is not None:
                if cleanup_error is not None:
                    if hasattr(failure, 'add_note'):
                        failure.add_note(f'Cleanup: {cleanup_error!r}')
                    else:
                        print(f'Cleanup: {cleanup_error!r}')
                raise failure
            if cleanup_error is not None:
                raise cleanup_error
    print(f'Native center {args.backend}: actual owners, source states, routes, draft, resize, paste, no replay: {artifacts}')


if __name__ == '__main__':
    main()
