#!/usr/bin/env python3
"""Run ordinary native checks on the operator-selected Neuroses host; never mutants."""
import argparse
import hashlib
import io
import re
from pathlib import Path
import shlex
import subprocess
import sys
import tarfile
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "neuroses"]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--test-regex", help="Run the matching CTest cases in each declared profile")
    parser.add_argument("--targets", nargs="+", help="Build only the owning targets for a scoped native check")
    parser.add_argument("--profiles", nargs="+", choices=("debug", "release", "asan", "fuzz"),
                        help="Select declared profiles for a changed-path recheck (default: debug, "
                             "release and asan; fuzz runs only when named)")
    parser.add_argument("--fuzz-runs", type=int, default=1000000,
                        help="Bounded libFuzzer executions of the profile reader in the fuzz profile")
    args = parser.parse_args()
    # Explicit current native unit source scope, excluding history, credentials and captures.
    paths = ["CMakeLists.txt", "include", "src", "tests", "programs", "tooling/probes",
             "assets", "packages", "profiles", "scripts/check-foundation-api", "scripts/check-terminal-pty", "scripts/check-new-session-pty", "scripts/check-participants-pty", "scripts/check-tiny-terminal-pty", "scripts/check-provider-auth", "scripts/check-trajectory", "scripts/check-observations", "scripts/check-tasks-pty", "scripts/check-command-jobs-pty", "scripts/check-command-jobs-station", "scripts/check-rrc", "scripts/arco", "scripts/blackbird", "scripts/terminal-screen-oracle.py", "scripts/native-packet.py"]
    paths.append("scripts/check-raw-capture")
    paths.append("scripts/check-trace-archive")
    paths.append("scripts/check-openrouter")
    paths.append("scripts/check-registered-responses")
    paths.append("scripts/check-session-startup")
    paths += ["scripts/tui-test", "scripts/check-tui-microsoft", "tooling/tui-test-profile.json"]
    paths.append("scripts/check-terminal-blocked")
    paths.append("scripts/check-application")
    paths.append("scripts/check-display-text")
    paths.append("scripts/check-tui-inspector")
    paths.append("scripts/check-tui-center")
    paths.append("scripts/check-tui-instrument")
    paths += ["scripts/check-terminal-edge", "scripts/check-tui-viewport", "scripts/check-main-input"]

    paths += ["scripts/check-anthropic", "scripts/install-blackbird", "scripts/check-install-blackbird"]
    lua_archive = ROOT.parent / "quarantine_proj/archives/lua-5.4.8.tar.gz"
    if hashlib.sha256(lua_archive.read_bytes()).hexdigest() != "4f18ddae154e793e46eeab727c59ef1c0c0c2b744e7b94219710d76f530629ae":
        raise RuntimeError("Lua 5.4.8 source archive checksum mismatch")
    archive = io.BytesIO()
    with tarfile.open(fileobj=archive, mode="w:gz") as bundle:
        bundle.add(lua_archive, arcname="tooling/dependencies/lua-5.4.8.tar.gz")
        for name in paths:
            path = ROOT / name
            if path.is_symlink():
                raise RuntimeError(f"unqualified source symlink: {name}")
            bundle.add(path, arcname=name)
    parent = ROOT / "context/linux"
    parent.mkdir(parents=True, exist_ok=True)
    capture = Path(tempfile.mkdtemp(prefix="run-", dir=parent))
    print(f"Linux capture: {capture}", flush=True)
    remote = subprocess.check_output([*SSH, "mktemp -d /tmp/arconaut-linux-XXXXXXXX"], text=True, timeout=15).strip()
    if not remote.startswith("/tmp/arconaut-linux-") or len(remote.splitlines()) != 1:
        raise RuntimeError("unexpected remote workspace")
    keep_remote = False
    try:
        subprocess.run([*SSH, "tar -xzf - -C " + shlex.quote(remote)], input=archive.getvalue(), check=True, timeout=30)
        commands = '''import platform, subprocess, tarfile, re
from pathlib import Path
root = Path.cwd()
# Explicit development-tool provisioning precedes configuration/testing.
if (selected_profiles != ['fuzz']) and (test_regex is None or any(re.search(test_regex, name) for name in
                             ('tui_microsoft', 'tui_command_inspector', 'tui_command_center', 'tui_retained_result'))):
    subprocess.run(['python3', str(root / 'scripts/tui-test'), '--install'], check=True)
    subprocess.run(['python3', str(root / 'scripts/tui-test'), '--check'], check=True)
print(platform.platform(), flush=True)
for tool in ('/usr/bin/clang++-23', '/usr/bin/cmake', '/usr/bin/ninja'):
    subprocess.run([tool, '--version'], check=True)
macros = subprocess.check_output(['/usr/bin/clang++-23', '-stdlib=libc++', '-std=c++23', '-dM', '-E', '-x', 'c++', '-include', 'version', '/dev/null'], text=True)
if '#define _LIBCPP_VERSION 230104\\n' not in macros:
    raise RuntimeError('Linux profile requires installed libc++ 23.1.4')
print('Linux standard library: libc++ 23.1.4', flush=True)
print('CTest selection:', test_regex if test_regex is not None else 'all', flush=True)
with tarfile.open(root / 'tooling/dependencies/lua-5.4.8.tar.gz', 'r:gz') as archive:
    archive.extractall(root / 'tooling/dependencies', filter='data')
lua = root / 'tooling/dependencies/lua-5.4.8/src'
subprocess.run(['make', '-C', str(lua), 'liblua.a', 'CC=/usr/bin/clang-23', 'MYCFLAGS=-DLUA_USE_LINUX -fPIC'], check=True)

for name, mode, instrumentation in [('debug', 'Debug', 'none'), ('release', 'Release', 'none'), ('asan', 'Debug', 'address'), ('fuzz', 'Debug', 'fuzz')]:
    if selected_profiles and name not in selected_profiles:
        continue
    if name == 'fuzz' and not selected_profiles:
        continue
    build = root / 'build' / name
    configure = ['/usr/bin/cmake', '-S', str(root), '-B', str(build), '-G', 'Ninja', '-DCMAKE_CXX_COMPILER=/usr/bin/clang++-23', '-DCMAKE_MAKE_PROGRAM=/usr/bin/ninja', '-DBLACKBIRD_COMPILER_PROFILE=linux-llvm23', '-DCMAKE_BUILD_TYPE='+mode, '-DBLACKBIRD_DEBUG='+('OFF' if mode == 'Release' else 'ON'), '-DBLACKBIRD_INSTRUMENTATION='+instrumentation, '-DLUA_INCLUDE_DIR='+str(lua), '-DLUA_LIBRARY='+str(lua / 'liblua.a')]
    if instrumentation == 'address':
        configure.append('-DCMAKE_CXX_FLAGS_DEBUG=-g -O1')
    subprocess.run(configure, check=True)
    if name == 'fuzz':
        # The profile reader fuzzer, bounded by executions; the corpus starts from copies
        # of the shipped profiles so libFuzzer never writes into the source tree.
        subprocess.run(['/usr/bin/cmake', '--build', str(build), '--parallel', '16', '--target', 'profile_reader_fuzz'], check=True)
        corpus = build / 'profile-reader-corpus'
        corpus.mkdir(exist_ok=True)
        for seed in sorted((root / 'profiles/providers').glob('*.lua')):
            (corpus / seed.name).write_bytes(seed.read_bytes())
        artifacts = build / 'artifacts'
        artifacts.mkdir(exist_ok=True)
        print('Fuzz artifacts (remote): ' + str(artifacts), flush=True)
        subprocess.run([str(build / 'profile_reader_fuzz'), '-runs=' + str(fuzz_runs), '-max_len=8192', '-seed=1', '-artifact_prefix=' + str(artifacts) + '/', str(corpus)], check=True)
        # The cut and repair frame decoder (unit S1): seeded with BBM2 frames written
        # by the development packet writer, bounded by the same executions.
        subprocess.run(['/usr/bin/cmake', '--build', str(build), '--parallel', '16', '--target', 'context_cut_fuzz'], check=True)
        import runpy, struct
        writer = runpy.run_path(str(root / 'scripts/native-packet.py'))['write_packet']
        def crc32c(data, crc=0):
            crc ^= 0xffffffff
            for byte in data:
                crc ^= byte
                for _ in range(8):
                    crc = (crc >> 1) ^ (0x82f63b78 if crc & 1 else 0)
            return crc ^ 0xffffffff
        def refs_crc(refs):
            crc = 0
            for record, ordinal in refs:
                crc = crc32c(bytes.fromhex(record) + struct.pack('<I', ordinal), crc)
            return crc
        cut_corpus = build / 'context-cut-corpus'
        cut_corpus.mkdir(exist_ok=True)
        rev = lambda n: format(n, '032x')
        fixed = '11' + '00' * 15  # the fuzz entry's fixed entries: record 0x11..., ordinals 0-2
        ref = lambda k: [fixed, k]
        item = lambda text: {'role': 'assistant', 'content': text}
        # Remove e0, replace e1, insert a fresh original at the start, re-insert e0
        # after e2: every apply step, with the result's CRC32C over the refs.
        cut_refs = [(rev(9), 0), (fixed, 1), (fixed, 2), (fixed, 0)]
        cut = {'op': 'cut', 'format': 'cut-delta-v1', 'revision': rev(9), 'base': rev(1), 'observed': rev(1), 'accepted': True,
               'kind': 'archival', 'changes': ['archive', 'edit', 'summary'], 'chapter': None, 'archived': [ref(0)], 'swept': [], 'reasoning': [],
               'replace': [{'ref': ref(1), 'item': item('x')}],
               'insert': [{'anchor': 'start', 'fresh': 0}, {'anchor': ref(2), 'existing': ref(0)}],
               'originals': [{'item': {'role': 'developer', 'content': 'note'}, 'class': 1}], 'refused': [], 'pending': None,
               'result': {'count': 4, 'crc32c': refs_crc(cut_refs), 'encoded_bytes': 0},
               'sizes': {'before': 10, 'prefix': 2}, 'cause': {'source': 'model', 'forced': True}}
        swept = dict(cut, archived=[], swept=[ref(2)], reasoning=[ref(1)], replace=[], insert=[{'anchor': ref(0), 'fresh': 0}],
                     result={'count': 2, 'crc32c': refs_crc([(fixed, 0), (rev(9), 0)]), 'encoded_bytes': 0})
        repair_refs = [(fixed, 0), (fixed, 1), (fixed, 2), (rev(8), 0)]
        repair = {'op': 'repair', 'format': 'repair-v1', 'revision': rev(8), 'base': None, 'observed': None, 'accepted': True,
                  'skipped': [rev(5), rev(6)], 'insert': [{'anchor': ref(2), 'fresh': 0}],
                  'originals': [{'item': {'role': 'user', 'content': 'kept'}, 'class': 0}],
                  'result': {'count': 4, 'crc32c': refs_crc(repair_refs), 'encoded_bytes': 0}, 'cause': {'source': 'operator'}}
        staged = {'op': 'cut', 'format': 'cut-delta-v1', 'revision': rev(7), 'observed': rev(1), 'accepted': False, 'reason': 'staged'}
        for name, packet in (('cut', cut), ('swept', swept), ('repair', repair), ('staged', staged)):
            writer(cut_corpus / name, packet)
        print('Fuzz artifacts (remote, context cut): ' + str(artifacts), flush=True)
        subprocess.run([str(build / 'context_cut_fuzz'), '-runs=' + str(fuzz_runs), '-max_len=8192', '-seed=1', '-artifact_prefix=' + str(artifacts) + '/cut-', str(cut_corpus)], check=True)
        # The state-file body and the saved-context validator (unit S1): seeds are
        # file-version-2 bodies, [u8 version][u32 core][u32 programs][body].
        subprocess.run(['/usr/bin/cmake', '--build', str(build), '--parallel', '16', '--target', 'saved_payload_fuzz'], check=True)
        payload_corpus = build / 'saved-payload-corpus'
        payload_corpus.mkdir(exist_ok=True)
        def packet_bytes(value):
            scratch = build / 'packet.tmp'
            writer(scratch, value)
            return scratch.read_bytes()
        def body(core, programs, entries, sections):
            out = bytearray(packet_bytes(core)) + packet_bytes(programs)
            core_size, program_size = len(packet_bytes(core)), len(packet_bytes(programs))
            for parts in (entries, sections):
                if parts is None:
                    out += struct.pack('<Q', 0)
                    continue
                out += struct.pack('<Q', len(parts) + 1)
                for part in parts:
                    encoded = packet_bytes(part)
                    out += struct.pack('<Q', len(encoded)) + encoded
            return bytes([2]) + struct.pack('<II', core_size, program_size) + bytes(out)
        programs = [{'label': 'session.identity'}]
        refs = [[fixed, 0], [fixed, 1]]
        inline = {'id': fixed + '.2', 'item': item('edited'), 'origin': 'legacy'}
        seeds = {
            'refs': body({'version': 2, 'base': rev(1), 'physical_records': 9}, programs, refs + [inline], []),
            'skipped': body({'version': 2, 'base': rev(1), 'skipped': [rev(5)]}, programs, refs, []),
            'empty': body({'version': 2, 'base': ''}, programs, [], []),
            'core-entries': body({'version': 2, 'base': rev(1), 'entries': 'x'}, programs, None, []),
        }
        for name, data in seeds.items():
            (payload_corpus / name).write_bytes(data)
        subprocess.run([str(build / 'saved_payload_fuzz'), '-runs=' + str(fuzz_runs), '-max_len=8192', '-seed=1', '-artifact_prefix=' + str(artifacts) + '/payload-', str(payload_corpus)], check=True)
        continue
    build_command = ['/usr/bin/cmake', '--build', str(build), '--parallel', '16']
    if build_targets:
        build_command += ['--target', *build_targets]
    subprocess.run(build_command, check=True)
    tests = ['/usr/bin/ctest', '--test-dir', str(build), '--output-on-failure', '--no-tests=error', '--parallel', '6']
    if test_regex is not None:
        tests += ['-R', test_regex]
    subprocess.run(tests, check=True)
    # The digests this build computes for the shipped set, for the three-location
    # check (scripts/check-installed-profiles), only when this run built blackbird;
    # a scratch home holds no overrides.
    if build_targets is None or 'blackbird' in build_targets:
        import tempfile
        with tempfile.TemporaryDirectory() as home:
            env = {'PATH': '/usr/bin:/bin', 'HOME': home}
            digests = subprocess.run([str(build / 'blackbird'), '--profile-digests'], env=env,
                                     check=True, capture_output=True, text=True).stdout
        for line in digests.splitlines():
            if line.startswith(('set-digest ', 'set-content-digest ', 'effective ')):
                print('linux-' + name + ' ' + line, flush=True)
'''
        commands = "test_regex = " + repr(args.test_regex) + "\nbuild_targets = " + repr(args.targets) + "\nselected_profiles = " + repr(args.profiles) + "\nfuzz_runs = " + repr(args.fuzz_runs) + "\n" + commands
        with (capture / "checks.log").open("wb") as output:
            result = subprocess.run([*SSH, "cd " + shlex.quote(remote) + " && python3 -"], input=commands.encode(), stdout=output, stderr=subprocess.STDOUT)
        if args.profiles and "fuzz" in args.profiles:
            # Crash, leak and timeout inputs come back before the remote workspace goes.
            # A failed or timed-out copy keeps the workspace, so no input is lost.
            kept = capture / "fuzz-artifacts"
            kept.mkdir()
            failure = None
            try:
                copy = subprocess.run([*SSH, "cd " + shlex.quote(remote) + " && if test -d build/fuzz/artifacts; then tar -czf - -C build/fuzz artifacts; else exit 3; fi"], capture_output=True, timeout=600)
                if copy.returncode == 3:
                    print("Fuzz artifacts: none (the fuzz step made no artifact directory)")
                elif copy.returncode != 0:
                    failure = f"exit {copy.returncode}: " + copy.stderr.decode(errors="replace").strip()
                else:
                    with tarfile.open(fileobj=io.BytesIO(copy.stdout), mode="r:gz") as bundle:
                        bundle.extractall(kept, filter="data")
                    found = sorted(str(path.relative_to(kept)) for path in kept.rglob("*") if path.is_file())
                    print(f"Fuzz artifacts kept in {kept}: " + (", ".join(found) if found else "none"))
            except subprocess.TimeoutExpired:
                failure = "timed out after 600 s"
            except (tarfile.TarError, OSError) as error:
                failure = f"unpacking failed: {error}"
            if failure:
                keep_remote = True
                note = f"Fuzz artifact copy-back failed ({failure}); remote workspace kept at neuroses:{remote}"
                (capture / "copy-back-error.txt").write_text(note + "\n")
                print(note, file=sys.stderr)
        if result.returncode:
            raise RuntimeError(f"Linux checks failed ({result.returncode}); inspect {capture / 'checks.log'}")
        # The profile digests each build printed (scripts/check-installed-profiles reads them).
        for line in (capture / "checks.log").read_text(errors="replace").splitlines():
            if re.match(r"linux-(debug|release|asan) (set-digest|set-content-digest|effective) ", line):
                print(line)
        selection = f" (CTest filter: {args.test_regex})" if args.test_regex is not None else ""
        checked_profiles = "/".join(args.profiles or ("debug", "release", "asan"))
        print("Linux " + checked_profiles + " native checks passed" + selection + ".")
    finally:
        # A kept workspace only skips the removal; the checks' own result still stands.
        if keep_remote:
            print(f"Remote workspace kept for its fuzz artifacts: neuroses:{remote}", file=sys.stderr)
        else:
            try:
                subprocess.run([*SSH, "rm -rf -- " + shlex.quote(remote)], check=True, timeout=15)
            except (subprocess.SubprocessError, OSError) as error:
                warning = f"Remote cleanup failed for {remote}: {error}"
                try:
                    (capture / "cleanup-error.txt").write_text(warning + "\n")
                except OSError:
                    warning += " (could not retain cleanup-error.txt)"
                print(warning, file=sys.stderr)


if __name__ == "__main__":
    main()
