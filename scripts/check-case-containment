#!/usr/bin/env python3
"""A timed-out, failed or orphaned CTest case leaves no process behind.

Builds a small CTest project that registers its cases through the repository's
own cmake/BlackbirdTests.cmake, runs it with the given cmake/ctest, and reads the
process table through scripts/process_table.py (independently of the launcher's
own process scan). Every
probe process carries a unique token in its argv; any token still present after
the case ends is a leaked process.
"""
import argparse
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile
import time
import uuid

import process_table

ROOT = Path(__file__).resolve().parent.parent

PROBE = r'''
import os, signal, sys, time
mode, token = sys.argv[1], sys.argv[2]

def hold(env=None):
    # The token stays in argv for the independent process-table oracle.
    argv = [sys.executable, "-c", "import time\nwhile True: time.sleep(60)", token]
    if env is None:
        os.execv(sys.executable, argv)
    os.execve(sys.executable, argv, env)

def detach():
    # tui-test style daemon: own session, reparented to init, stdio detached.
    if os.fork() == 0:
        os.setsid()
        if os.fork() == 0:
            null = os.open(os.devnull, os.O_RDWR)
            for fd in (0, 1, 2):
                os.dup2(null, fd)
            hold()
        os._exit(0)
    os.wait()

if mode == "detach":
    detach()
elif mode in ("hung-detached", "runner-death"):
    detach()
    print("probe ready", flush=True)
    while True:
        time.sleep(60)
elif mode == "hung-scrubbed":
    # A child with an empty environment, still linked by its parent.
    if os.fork() == 0:
        hold(env={})
    print("probe ready", flush=True)
    while True:
        time.sleep(60)
elif mode == "exited-holder":
    # The case exits but a child still holds CTest's output pipe.
    if os.fork() == 0:
        hold()
    print("probe exits early", flush=True)
    sys.exit(0)
elif mode == "passes":
    child = os.fork()
    if child == 0:
        os._exit(0)
    os.waitpid(child, 0)
    print("CONTAINMENT_PASS_OUTPUT", flush=True)
elif mode == "status":
    sys.exit(3)
elif mode == "signal":
    os.kill(os.getpid(), signal.SIGUSR1)
'''

CASES = {  # name: (probe mode, TIMEOUT seconds)
    "hung_detached": ("hung-detached", 3),
    "hung_scrubbed": ("hung-scrubbed", 3),
    "exited_holder": ("exited-holder", 15),
    "passes": ("passes", 10),
    "status": ("status", 10),
    "signal": ("signal", 10),
    "runner_death": ("runner-death", 30),
}


def survivors(tokens):
    found = []
    for pid, _, command in process_table.processes():
        if any(token in command for token in tokens) and pid != os.getpid():
            found.append((pid, command))
    return found


def wait_until(predicate, seconds):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if predicate():
            return True
        time.sleep(0.1)
    return predicate()


def results(output):
    found = {}
    for match in re.finditer(r"Test\s+#\d+: (\S+) \.*\s*(.*?)\s+[\d.]+ sec", output):
        found[match.group(1)] = match.group(2).strip()
    return found


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("cmake")
    parser.add_argument("ctest")
    parser.add_argument("--launcher", help="case launcher executable for the inner project")
    args = parser.parse_args()
    run = uuid.uuid4().hex[:12]
    tokens = {name: f"containment-{name}-{run}" for name in [*CASES, "orphan_check"]}
    failures = []
    output = ""
    with tempfile.TemporaryDirectory(prefix="blackbird-containment-") as temporary:
        work = Path(temporary)
        source, build = work / "source", work / "build"
        source.mkdir()
        (source / "probe.py").write_text(PROBE)
        lines = ["cmake_minimum_required(VERSION 3.28)", "project(containment NONE)",
                 "enable_testing()", f'include("{ROOT / "cmake/BlackbirdTests.cmake"}")']
        for name, (mode, timeout) in CASES.items():
            lines.append(f'blackbird_add_test(NAME {name} COMMAND "{sys.executable}" '
                         f'"{source / "probe.py"}" {mode} {tokens[name]})')
            lines.append(f"set_tests_properties({name} PROPERTIES TIMEOUT {timeout})")
        lines.append("blackbird_require_registered_tests()")
        (source / "CMakeLists.txt").write_text("\n".join(lines) + "\n")
        configure = [args.cmake, "-S", str(source), "-B", str(build)]
        if args.launcher:
            configure.append(f"-DBLACKBIRD_CASE_LAUNCHER={Path(args.launcher).resolve()}")
        subprocess.run(configure, check=True, capture_output=True, timeout=60)
        try:
            inner = subprocess.run([args.ctest, "--test-dir", str(build), "--parallel", "6",
                                    "--output-on-failure", "-E", "^runner_death$"],
                                   capture_output=True, text=True)
            output = inner.stdout + inner.stderr
            status = results(output)
            # CTest prints the exception name before its ***Exception marker.
            expected = {"hung_detached": ("***Timeout",), "hung_scrubbed": ("***Timeout",),
                        "exited_holder": ("***Failed",), "passes": ("Passed",),
                        "status": ("***Failed",), "signal": ("***Exception", "SIGUSR1")}
            for name, needles in expected.items():
                if not all(needle in status.get(name, "") for needle in needles):
                    failures.append(f"{name}: expected {needles}, CTest reported {status.get(name)!r}")
            if "CONTAINMENT_PASS_OUTPUT" in output and status.get("passes") != "Passed":
                failures.append("passing case output reached CTest but the case did not pass")
            if tokens["exited_holder"] not in output:
                failures.append("exited_holder: the leaked process was not named in the case output")
            for name in expected:
                left = survivors([tokens[name]])
                if left:
                    failures.append(f"{name}: processes survived the case: {left}")
            # The runner itself dies: the case's launcher must take its tree down.
            runner = subprocess.Popen([args.ctest, "--test-dir", str(build), "-R", "^runner_death$"],
                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                      start_new_session=True)
            token = tokens["runner_death"]
            # The detached daemon is the one with the token and no probe.py argv.
            ready = wait_until(lambda: any("probe.py" not in command
                                           for _, command in survivors([token])), 20)
            os.kill(runner.pid, signal.SIGKILL)
            runner.wait()
            if not ready:
                failures.append("runner_death: probe daemon never started")
            elif not wait_until(lambda: not survivors([token]), 5):
                failures.append(f"runner_death: processes survived the killed runner: {survivors([token])}")
            # The suite-level check (scripts/rigor): a detached process carrying
            # the run's entry is named, ended and reported with status 1.
            if args.launcher:
                token = tokens["orphan_check"]
                entry = f"BLACKBIRD_TEST_RUN={token}"
                subprocess.run([sys.executable, str(source / "probe.py"), "detach", token],
                               env=dict(os.environ, BLACKBIRD_TEST_RUN=token), check=True,
                               timeout=30)
                if not wait_until(lambda: survivors([token]), 10):
                    failures.append("orphan_check: probe daemon never started")
                clean = subprocess.run([args.launcher, "--orphans", "BLACKBIRD_TEST_RUN=none-" + run],
                                       capture_output=True, text=True, timeout=60)
                found = subprocess.run([args.launcher, "--orphans", entry],
                                       capture_output=True, text=True, timeout=60)
                if clean.returncode != 0:
                    failures.append(f"orphan_check: unmatched entry reported {clean.stderr!r}")
                if found.returncode != 1 or token not in found.stderr:
                    failures.append(f"orphan_check: expected status 1 naming the orphan, got "
                                    f"{found.returncode} {found.stderr!r}")
                if not wait_until(lambda: not survivors([token]), 5):
                    failures.append(f"orphan_check: orphan still running: {survivors([token])}")
        finally:
            for pid, _ in survivors(list(tokens.values())):
                try:
                    os.kill(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
    if failures:
        print("\n".join(failures), file=sys.stderr)
        print(output, file=sys.stderr)
        sys.exit(1)
    print("case containment: timed-out, scrubbed, orphaned, signalled and runner-death cases leave no process")


if __name__ == "__main__":
    main()
