#!/usr/bin/env python3
"""Actual launcher capture, clean drain, reopen and read-only inspection."""
from pathlib import Path
import struct
import subprocess
import sys
import tempfile

binary = str(Path(sys.argv[1]).resolve())


def records(run):
    found = []
    for segment in sorted(run.glob("events.*")):
        data = segment.read_bytes()
        assert data[:8] == b"ARCOJ001"
        offset = 112
        while offset < len(data):
            magic, version, kind, sequence, first, length, crc = struct.unpack_from(
                "<4sHHQQII", data, offset)
            assert magic == b"ARJ1" and version == 1 and first <= sequence
            end = offset + 32 + length
            assert end <= len(data), "clean exit left a partial raw frame"
            if kind == 4:
                payload = data[offset + 32:end]
                lane = payload[:16]
                partition, reserved, source = struct.unpack_from("<IIQ", payload, 16)
                size, site, ordinal = struct.unpack_from("<IIQ", payload, 32)
                assert reserved == 0 and size == len(payload) - 32
                assert partition in (1, 2, 3) and ordinal > 0
                found.append((lane, site, ordinal, payload[48:]))
            offset = end
        assert offset == len(data)
    assert found, "launcher emitted no preserved records"
    assert len({(lane, ordinal) for lane, site, ordinal, body in found}) == len(found)
    assert not any(site in (8000, 8001) for lane, site, ordinal, body in found)
    return found


def region(found, base, outcome):
    begins = [(lane, ordinal) for lane, site, ordinal, body in found if site == base]
    assert len(begins) == 1, (base, begins)
    lane, begin = begins[0]
    ends = [body for owner, site, ordinal, body in found
            if owner == lane and site == base + 1]
    outcomes = [body for owner, site, ordinal, body in found
                if owner == lane and site == base + 4]
    assert len(ends) == 1 and struct.unpack_from("<Q", ends[0])[0] == begin
    assert len(outcomes) == 1
    linked, actual = struct.unpack("<QI", outcomes[0])
    assert linked == begin and actual in outcome, (base, actual)


def product_storage(found, audit, reopened):
    def one(site):
        selected = [(lane, ordinal, body) for lane, current, ordinal, body in found
                    if current == site]
        assert len(selected) == 1, (site, len(selected))
        return selected[0]

    def ref(lane, ordinal):
        return lane + struct.pack("<Q", ordinal)

    startup_lane, startup_ordinal, _ = one(1000)
    owner_lane, owner_ordinal, owner_body = one(3000)
    assert owner_body == b"\x01" + ref(startup_lane, startup_ordinal) + b"\x01"
    _, _, owner_return = one(3001)
    assert owner_return == ref(owner_lane, owner_ordinal) + b"\x00"
    factory_lane, factory_ordinal, factory_body = one(3104)
    assert factory_body[:24] == ref(owner_lane, owner_ordinal)
    header = audit.read_bytes()[:112]
    assert factory_body[24:64] == header[8:48], "factory emitted different native identities"
    assert factory_body[64:72] == header[84:92], "factory emitted different native limits"
    capacity = struct.pack("<QQB", 512 * 1024 * 1024, 200000, 2 if reopened else 1)
    assert factory_body[72:90] == b"\x00" + capacity
    if reopened:
        assert factory_body[90:] == struct.pack("<BBQ", 0, 1, 64 * 1024 * 1024)
    else:
        assert len(factory_body) == 90
    _, _, factory_return = one(3105)
    assert factory_return[:24] == ref(factory_lane, factory_ordinal)
    assert len(factory_return) == 61 and factory_return[-1] == 0
    assert factory_return[24:40] == header[24:40]
    end_lane, end_ordinal, end_body = one(3108)
    assert end_body[:24] == ref(factory_lane, factory_ordinal)
    assert len(end_body) == 56 and end_body[24:40] == header[24:40]
    _, _, ended = one(3109)
    assert ended[:24] == ref(end_lane, end_ordinal) and len(ended) == 28
    assert ended[24:] == bytes(4), "owner exited with pending/failed state"
    assert any(site == 3100 for lane, site, ordinal, body in found)
    assert any(site == 3017 for lane, site, ordinal, body in found)


with tempfile.TemporaryDirectory(prefix="blackbird-raw-capture-") as temporary:
    session = Path(temporary) / "session"
    for index in range(2):
        result = subprocess.run(
            [binary, "--session", str(session), "--once",
             "/lua print('RAW_CAPTURE_LAUNCH')"],
            capture_output=True, text=True, check=True, timeout=10)
        assert "RAW_CAPTURE_LAUNCH" in result.stdout
        runs = list((session / "raw").iterdir())
        assert len(runs) == index + 1
        current = max(runs, key=lambda run: run.stat().st_mtime_ns)
        assert (current / "descriptions").read_bytes()[:8] == b"BBRAWABI"
        assert (current / "closed").exists(), "launcher failed to drain its recorder"
        found = records(current)
        region(found, 1000, {1})  # startup ready
        product_storage(found, session / "audit", bool(index))
        assert any(site == 1090 for lane, site, ordinal, body in found)
        if index:
            region(found, 1010, {2, 3})  # compact recovery or full replay
    snapshot = {str(path): path.read_bytes() for path in (session / "raw").rglob("*")
                if path.is_file()}
    subprocess.run([binary, "--session", str(session), "--audit-last"],
                   capture_output=True, check=True, timeout=10)
    assert snapshot == {str(path): path.read_bytes()
                        for path in (session / "raw").rglob("*") if path.is_file()}, \
        "read-only inspection changed the metric stream"
print("Launcher raw capture: ready, exact product storage owner/factory/end, reopen and inspection pass")
