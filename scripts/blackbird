#!/bin/sh
set -eu
blackbird_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
# Only a nonsecret locator is exported; credentials are read lazily by native code.
if [ -z "${BLACKBIRD_JEV_ENV_FILE:-}" ] && [ -f "$blackbird_root/../.env" ]; then
  BLACKBIRD_JEV_ENV_FILE="$blackbird_root/../.env"
  export BLACKBIRD_JEV_ENV_FILE
fi
# A checkout follows the selected installed generation. Packaged launchers stay
# within their own generation; an explicit development executable always wins.
if [ -z "${BLACKBIRD_EXECUTABLE:-}${ARCO_EXECUTABLE:-}" ] &&
   [ -f "$blackbird_root/programs/turn.lua" ] &&
   [ -x "$HOME/.local/bin/blackbird" ] &&
   [ ! -L "$HOME/.local/bin/blackbird" ] &&
   [ "$(sed -n '2p' "$HOME/.local/bin/blackbird")" = '# blackbird managed launcher v1' ]; then
  exec "$HOME/.local/bin/blackbird" "$@"
fi
blackbird_executable=${BLACKBIRD_EXECUTABLE:-${ARCO_EXECUTABLE:-"$blackbird_root/build/release/blackbird"}}
if [ ! -x "$blackbird_executable" ]; then
  printf 'Blackbird executable is not runnable: %s\nRun ./scripts/install-blackbird to install or update the harness.\n' "$blackbird_executable" >&2
  exit 127
fi
BLACKBIRD_SPRITE_ASSET=${BLACKBIRD_SPRITE_ASSET:-"$blackbird_root/assets/sr71.png"}
export BLACKBIRD_SPRITE_ASSET
if [ "${1:-}" = auth ]; then
  exec "$blackbird_executable" "$@"
fi
blackbird_probe=false
blackbird_session=''
blackbird_session_option=false
blackbird_existing_session=false
blackbird_plain=false
blackbird_once=false
blackbird_value=''
for blackbird_argument in "$@"; do
  if [ -n "$blackbird_value" ]; then
    if [ "$blackbird_value" = session ]; then
      blackbird_session=$blackbird_argument
      blackbird_session_option=true
    fi
    blackbird_value=''
    continue
  fi
  case "$blackbird_argument" in
    --help|--list-sessions) blackbird_probe=true ;;
    --audit-last|--expire-diagnostics|--rebuild-session|--recover-unknown-effects|--resume-continue)
      blackbird_existing_session=true ;;
    --session) blackbird_value=session ;;
    --model|--effort|--workflow|--provider|--seed-session|--backstop|--station) blackbird_value=skip ;;
    --once) blackbird_once=true; blackbird_value=skip ;;
    --resume-once) blackbird_once=true; blackbird_existing_session=true ;;
    --plain) blackbird_plain=true ;;
  esac
done
if ! "$blackbird_session_option" && "$blackbird_existing_session" && ! "$blackbird_probe"; then
  printf 'Select an existing session with --session DIRECTORY for inspection, recovery, continuation or maintenance.\n' >&2
  exit 1
fi
if ! "$blackbird_session_option" && ! "$blackbird_probe" && ! "$blackbird_existing_session"; then
  blackbird_session=$(
    umask 077
    mkdir -p -- "$HOME/.local/state/blackbird"
    mktemp -d "$HOME/.local/state/blackbird/session-XXXXXX"
  )
  set -- "$@" --session "$blackbird_session"
  printf 'Starting Blackbird session: %s\n' "$blackbird_session" >&2
fi
if "$blackbird_session_option" && ! "$blackbird_once" && ! "$blackbird_probe" && [ -t 0 ] && [ -t 1 ]; then
  printf 'Opening Blackbird session: %s\n' "$blackbird_session" >&2
fi
# The session runs as an asynchronous child so this shell can take SIGTERM while
# it waits and forward it: a supervisor that signals only this pid still stops
# the session cleanly (status 143). A TERM before the child's pid is known is
# kept and forwarded at once; none starts a relaunch. The child reads this
# shell's stdin through descriptor 9, because dash gives an asynchronous list
# /dev/null as stdin before its explicit redirections; a closed stdin stays
# closed. Such a child also starts with SIGINT and SIGQUIT ignored:
# BLACKBIRD_WRAPPED_CHILD tells it to restore their default actions. A
# terminal's SIGINT reaches the session directly; the INT trap only keeps this
# shell waiting.
blackbird_child=''
blackbird_terminated=false
blackbird_signalled=false
trap 'blackbird_terminated=true; blackbird_signalled=true; if [ -n "$blackbird_child" ]; then kill -TERM "$blackbird_child" 2>/dev/null || :; fi' TERM
trap 'blackbird_signalled=true' INT
if { true 9<&0; } 2>/dev/null; then
  blackbird_stdin=open
  exec 9<&0
else
  blackbird_stdin=closed
fi
while :; do
  if "$blackbird_terminated"; then exit 143; fi
  if [ "$blackbird_stdin" = open ]; then
    BLACKBIRD_WRAPPED_CHILD=1 "$blackbird_executable" "$@" <&9 9<&- &
  else
    BLACKBIRD_WRAPPED_CHILD=1 "$blackbird_executable" "$@" <&- &
  fi
  blackbird_child=$!
  if "$blackbird_terminated"; then kill -TERM "$blackbird_child" 2>/dev/null || :; fi
  blackbird_status=''
  while :; do
    blackbird_signalled=false
    if wait "$blackbird_child"; then blackbird_waited=0; else blackbird_waited=$?; fi
    # 127: this shell already reported the child (bash 3.2 forgets it).
    if [ "$blackbird_waited" -eq 127 ] && [ -n "$blackbird_status" ]; then break; fi
    blackbird_status=$blackbird_waited
    # A trapped signal ends wait early, above 128, while the child runs on.
    if "$blackbird_signalled" && [ "$blackbird_waited" -gt 128 ]; then continue; fi
    break
  done
  blackbird_child=''
  if [ "$blackbird_status" -eq 0 ]; then exit 0; fi
  if [ "$blackbird_status" -ne 75 ] || "$blackbird_terminated"; then exit "$blackbird_status"; fi
  set -- --session "$blackbird_session" --resume-continue
  if "$blackbird_plain"; then set -- "$@" --plain; fi
  if "$blackbird_once"; then set -- "$@" --resume-once; fi
done
